# CrediPay MDM - Backend (WAMP / desarrollo)
DB_HOST=localhost
DB_PORT=3306
DB_USER=credipay
DB_PASS=cambiar-esta-password
DB_NAME=credipay_mdm

# API
APP_PORT=4000
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Seguridad
SESSION_SECRET=cadena-aleatoria-de-al-menos-32-caracteres
COOKIE_SECURE=false

# Migraciones (ruta relativa a server/)
MIGRATIONS_DIR=./migraciones

# Scheduler (Fase 8) - deja vacío para usar system_settings.scheduler.enabled
# SCHEDULER_ENABLED=true|false

# Backups (Fase 8)
# BACKUP_DIR=./backups
# MYSQLDUMP_PATH=C:\wamp64\bin\mysql\mysql8.4.7\bin\mysqldump.exe

# Email transaccional SMTP (Fase 8) - configura para activar envíos reales
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=usuario
# SMTP_PASS=password
# SMTP_FROM=CrediPay MDM <no-reply@credipay.local>
# SMTP_SECURE=false