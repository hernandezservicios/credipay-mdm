# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS MySQL EN HOSTINGER
# Copia este archivo como .env y coloca los datos de tu hPanel de Hostinger
# ==============================================================================

PORT=3001
NODE_ENV=production

# Parámetros de Conexión MySQL en Hostinger
DB_HOST=srvXXX.hstgr.io # O localhost si la API de Node.js corre en el mismo cPanel/VPS de Hostinger
DB_PORT=3306
DB_USER=uXXXXX_mdm_admin
DB_PASSWORD=tu_password_seguro_de_hostinger
DB_NAME=uXXXXX_mdm_credipay
DB_CONNECTION_LIMIT=10

# API Token interno (opcional) para proteger tu servidor de cobranza
API_SECRET_TOKEN=credipay_secure_token_2026
